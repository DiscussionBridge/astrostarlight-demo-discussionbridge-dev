{
  "name": "discussionbridge-demo-starlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test test/*.test.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy --strict",
    "publish-new:dry-run": "astro-discussion-bridge publish-new src/content/docs --dry-run --discourse-url https://forum.discussionbridge.dev --site-url https://astrostarlight.demo.discussionbridge.dev --category-id 5 --tags discussionbridge,astro,starlight-demo",
    "sync-existing:dry-run": "astro-discussion-bridge sync-existing src/content/docs --dry-run --unlist --discourse-url https://forum.discussionbridge.dev --site-url https://astrostarlight.demo.discussionbridge.dev --category-id 5 --tags discussionbridge,astro,starlight-demo",
    "publish-and-sync:dry-run": "astro-discussion-bridge publish-and-sync src/content/docs --dry-run --unlist --discourse-url https://forum.discussionbridge.dev --site-url https://astrostarlight.demo.discussionbridge.dev --category-id 5 --tags discussionbridge,astro,starlight-demo"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.2",
    "astro": "^7.0.4",
    "astro-discussion-bridge": "file:vendor/astro-discussion-bridge-0.1.0-alpha.20260824.3.tgz"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
