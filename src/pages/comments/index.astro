---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const posts = (await getCollection("comments")).sort(
  (a, b) => a.data.title.localeCompare(b.data.title),
);
---

<StarlightPage
  frontmatter={{
    title: "Comments Mode Demos",
    description: "Compare plugin-free simple and full comments with DiscussionBridge fullInteractive.",
    editUrl: false,
  }}
>
  <p>
    Compare all three supported Astro comment presentations. <code>simple</code>
    and <code>full</code> work without installing the DiscussionBridge receiver
    plugin. <code>fullInteractive</code> adds durable mapping and the enhanced
    comments-only Discourse experience.
  </p>
  <aside>
    <strong>Discourse content display:</strong> Discourse Core enables
    <code>embed_truncate</code> by default. A forum topic initially shows an
    excerpt of the imported page with <strong>Show more…</strong> for the full
    rendered article. A forum operator can disable that setting to show the
    complete imported article immediately. DiscussionBridge does not silently
    assume either operator choice.
  </aside>
  <ul>
    {posts.map((entry) => (
      <li><a href={`/comments/${entry.id}/`}>{entry.data.title}</a></li>
    ))}
  </ul>
</StarlightPage>

<style>
  nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 1rem 2rem; }
  li { margin-block: 0.75rem; }
  aside {
    margin-block: 1.5rem;
    border-inline-start: 0.25rem solid var(--sl-color-accent);
    padding: 0.75rem 1rem;
    background: var(--sl-color-gray-6);
  }
</style>
