---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const posts = (await getCollection("comments")).sort(
  (a, b) => a.data.title.localeCompare(b.data.title),
);
---

<StarlightPage
  frontmatter={{
    title: "Comments Mode Demos",
    description: "Mapped comments-only fullInteractive routes backed by DiscussionBridge.",
    editUrl: false,
  }}
>
  <p>Mapped comments-only <code>fullInteractive</code> routes backed by DiscussionBridge.</p>
  <ul>
    {posts.map((entry) => (
      <li><a href={`/comments/${entry.id}/`}>{entry.data.title}</a></li>
    ))}
  </ul>
</StarlightPage>

<style>
  nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 1rem 2rem; }
  li { margin-block: 0.75rem; }
</style>
