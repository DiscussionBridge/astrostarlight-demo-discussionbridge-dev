---
import { getCollection } from "astro:content";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const posts = (await getCollection("comments")).sort(
  (a, b) => a.data.title.localeCompare(b.data.title),
);
---

<StarlightPage
  frontmatter={{
    title: "Comments Mode Demos",
    description: "Compare plugin-free simple and full comments with DiscussionBridge fullInteractive.",
    editUrl: false,
  }}
>
  <p>
    Compare all three supported Astro comment presentations. <code>simple</code>
    and <code>full</code> work without installing the DiscussionBridge receiver
    plugin. <code>fullInteractive</code> adds durable mapping and the enhanced
    comments-only Discourse experience.
  </p>
  <ul>
    {posts.map((entry) => (
      <li><a href={`/comments/${entry.id}/`}>{entry.data.title}</a></li>
    ))}
  </ul>
</StarlightPage>

<style>
  nav { display: flex; flex-wrap: wrap; gap: 1rem; margin-block: 1rem 2rem; }
  li { margin-block: 0.75rem; }
</style>
