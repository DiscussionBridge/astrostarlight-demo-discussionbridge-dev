---
import Discussion from "astro-discussion-bridge/Discussion.astro";
import FromDiscourse from "astro-discussion-bridge/FromDiscourse.astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

interface Props {
  commentsDisplay?: "simple" | "full" | "fullInteractive";
  fromDiscourse?: boolean;
  date: Date;
  description: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
  laneLabel: string;
  title: string;
  topicId?: number | string;
  topicUrl?: string;
  resourceId?: string;
}

const formattedDate = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
}).format(Astro.props.date);
---

<StarlightPage
  headings={Astro.props.headings}
  frontmatter={{
    title: Astro.props.title,
    description: Astro.props.description,
    editUrl: false,
  }}
>
  <p class="lane">{Astro.props.laneLabel}</p>
  <p class="description">{Astro.props.description}</p>
  <p class="date">{formattedDate}</p>
  <article>
    <slot />
  </article>
  {Astro.props.commentsDisplay && Astro.props.topicUrl && (
    <Discussion
      discourseUrl={new URL(Astro.props.topicUrl).origin}
      display={Astro.props.commentsDisplay}
      heading="Discussion"
      topicId={Astro.props.topicId}
      topicUrl={Astro.props.topicUrl}
    />
  )}
  {Astro.props.fromDiscourse && Astro.props.resourceId && (
    <FromDiscourse
      discourseUrl="https://sandbox-forum.discussionbridge.dev"
      resourceId={Astro.props.resourceId}
    />
  )}
</StarlightPage>

<style>
  .lane,
  .date {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .lane {
    margin-block-start: 0;
    font-weight: 700;
    text-transform: uppercase;
  }

  .description {
    font-size: var(--sl-text-lg);
  }

  article {
    margin-block-start: 3rem;
  }
</style>
