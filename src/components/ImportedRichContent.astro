<script>
  import katex from "katex";
  import mermaid from "mermaid";

  const roots = Array.from(document.querySelectorAll<HTMLElement>(".discussionbridge-record"));

  for (const root of roots) {
    const diagrams = Array.from(
      root.querySelectorAll<HTMLElement>("pre > code.lang-mermaid, pre > code.language-mermaid"),
    ).map((code) => {
      const pre = code.parentElement as HTMLPreElement;
      pre.className = "mermaid";
      pre.textContent = code.textContent ?? "";
      return pre;
    });

    if (diagrams.length > 0) {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        theme: document.documentElement.dataset.theme === "dark" ? "dark" : "default",
      });
      await mermaid.run({ nodes: diagrams });
    }

    for (const paragraph of root.querySelectorAll<HTMLParagraphElement>("p")) {
      const match = paragraph.textContent?.trim().match(/^\[math\]([\s\S]*?)\[\/math\]$/);
      if (!match) continue;
      const target = document.createElement("div");
      target.className = "discussionbridge-math";
      katex.render(match[1].trim(), target, {
        displayMode: true,
        throwOnError: false,
        strict: "warn",
      });
      paragraph.replaceWith(target);
    }

    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];
    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      const parent = node.parentElement;
      if (!parent || parent.closest("code, pre, script, style, .katex")) continue;
      if (/\[math\][\s\S]*?\[\/math\]/.test(node.data)) textNodes.push(node);
    }

    for (const node of textNodes) {
      const fragment = document.createDocumentFragment();
      let cursor = 0;
      const matches = node.data.matchAll(/\[math\]([\s\S]*?)\[\/math\]/g);
      for (const match of matches) {
        const index = match.index ?? 0;
        fragment.append(node.data.slice(cursor, index));
        const expression = match[1].trim();
        const target = document.createElement(expression.includes("\n") ? "div" : "span");
        target.className = "discussionbridge-math";
        katex.render(expression, target, {
          displayMode: target.tagName === "DIV",
          throwOnError: false,
          strict: "warn",
        });
        fragment.append(target);
        cursor = index + match[0].length;
      }
      fragment.append(node.data.slice(cursor));
      node.replaceWith(fragment);
    }
  }
</script>
